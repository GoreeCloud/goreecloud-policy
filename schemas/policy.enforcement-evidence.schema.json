{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/schemas/policy.enforcement-evidence.schema.json",
  "title": "GoreeCloud Policy Enforcement Evidence",
  "description": "Evidence describing what an enforcement point actually did with a GoreeCloud Policy decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "evidence_id",
    "decision_id",
    "request_id",
    "enforcement_point",
    "action",
    "resource_ref",
    "decision_outcome",
    "enforcement_result",
    "enforced_at",
    "policy_refs",
    "conditions",
    "reason_code",
    "correlation_id",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {"const": "0.1"},
    "evidence_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "enforcement_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "type", "identity_ref"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "type": {"enum": ["application", "service", "gateway", "agent", "runtime", "system"]},
        "identity_ref": {"type": ["string", "null"]}
      }
    },
    "action": {"type": "string", "minLength": 1},
    "resource_ref": {"type": "string", "minLength": 1},
    "decision_outcome": {"enum": ["allow", "deny", "conditional", "defer", "indeterminate", "error"]},
    "enforcement_result": {"enum": ["allowed", "denied", "blocked-condition-unsatisfied", "deferred", "not-enforced", "failed"]},
    "enforced_at": {"type": "string", "format": "date-time"},
    "policy_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["policy_id", "policy_version", "owner_authority"],
        "properties": {
          "policy_id": {"type": "string", "minLength": 1},
          "policy_version": {"type": "string", "minLength": 1},
          "owner_authority": {"type": "string", "minLength": 1}
        }
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition_id", "status", "evidence_ref"],
        "properties": {
          "condition_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["satisfied", "unsatisfied", "not-evaluated"]},
          "evidence_ref": {"type": ["string", "null"]}
        }
      }
    },
    "reason_code": {"type": "string", "minLength": 1},
    "correlation_id": {"type": ["string", "null"]},
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"decision_outcome": {"const": "allow"}}, "required": ["decision_outcome"]},
      "then": {"properties": {"enforcement_result": {"enum": ["allowed", "denied", "not-enforced", "failed"]}}}
    },
    {
      "if": {"properties": {"decision_outcome": {"const": "deny"}}, "required": ["decision_outcome"]},
      "then": {"properties": {"enforcement_result": {"enum": ["denied", "not-enforced", "failed"]}}}
    },
    {
      "if": {"properties": {"decision_outcome": {"enum": ["indeterminate", "error"]}}, "required": ["decision_outcome"]},
      "then": {"properties": {"enforcement_result": {"enum": ["not-enforced", "denied", "failed"]}}}
    }
  ]
}
